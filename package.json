{
  "name": "context-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Context: an organizational intelligence agent. Reads through a data port (Zetaris in production), remembers through Meterless H-MEM, and keeps an evidence graph in the Meterless World Model.",
  "license": "Apache-2.0",
  "scripts": {
    "seed": "tsx scripts/seed.ts",
    "eval": "tsx scripts/eval.ts",
    "ask": "tsx scripts/ask.ts",
    "typecheck": "tsc --noEmit",
    "start": "tsx server/index.ts",
    "ui-test": "tsx scripts/ui-test.ts",
    "deploy-test": "tsx scripts/deploy-test.ts",
    "llm-test": "tsx scripts/llm-test.ts",
    "llm-live": "tsx scripts/llm-live.ts",
    "demo-test": "tsx scripts/demo-test.ts",
    "team-test": "tsx scripts/team-test.ts",
    "ask:live": "tsx scripts/ask-live.ts",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "trace": "tsx scripts/trace.ts",
    "zetaris-test": "tsx scripts/zetaris-test.ts",
    "zetaris:register": "tsx scripts/zetaris-register.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.1",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jsdom": "^30.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
